---
import { copy } from '../content/site';
import { href, type Locale } from '../lib/routes';
import ProductVisual from './ProductVisual.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
---

<div class="product-grid">
  {(['datahub', 'tickets'] as const).map((kind, i) => (
    <article class:list={['product-card', `card-${kind}`]}>
      <div class="product-card-top">
        <span class="eyebrow">
          0{i + 1} / {t[kind].category}
        </span>
        <span class="card-symbol" aria-hidden="true">
          {kind === 'datahub' ? '◈' : '✳︎'}
        </span>
      </div>
      <h3>{t[kind].name}</h3>
      <p>{t[kind].summary}</p>
      <ProductVisual locale={locale} kind={kind} compact />
      <a class="product-link" href={href(kind, locale)}>
        <span>
          {t.explore}
          <span class="sr-only">: {t[kind].name}</span>
        </span>
      </a>
    </article>
  ))}
</div>
